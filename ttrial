local function startSpectate(target)
    if not target or not target.Character then
        return
    end

    local targetHumanoid = target.Character:FindFirstChildOfClass(_SDec("1b0005ddcd3c1c0c",{83,117,104,188,163}))
    local targetRoot = target.Character:FindFirstChild(_SDec("54f7071848092578d0051652362d6ef6",{28,130,106,121,38,102,76}))
    if not targetHumanoid or not targetRoot then
        return
    end

    local camera = workspace.CurrentCamera
    if not camera then
        return
    end

    OriginalCameraType = camera.CameraType
    OriginalCameraSubject = camera.CameraSubject

    SpectateActive = true
    SpectateTarget = target
    setButtonState(SpectateBtn, true, T18T(_SDec("8d08d7e9522acbf275af4d5237cad1748bb53e48b48c2ad6c25239",{85,173,14,109,138,144,19})), T18T(_SDec("6713bdb8e8316711bda3e83f",{190,150,101,12,48,150})), Theme.Active, Theme.PanelSoft)
    createSpectateLabels(target)

    if SpectatePlayerRemovingConnection then
        SpectatePlayerRemovingConnection:Disconnect()
        SpectatePlayerRemovingConnection = nil
    end

    SpectatePlayerRemovingConnection = Players.PlayerRemoving:Connect(function(player)
        if player == target then
            showSpectateWarning(_SDec("9f21e40cdbf788e05e8450aa5388e95e8c50ae5389c25fbba8dad489c35fb950bbabf89f2f",{71,134,61,136,2,115,80}))
            task.delay(0.7, function()
                if SpectateTarget == target then
                    stopSpectate(true)
                end
            end)
        end
    end)

    camera.CameraType = Enum.CameraType.Custom
    camera.CameraSubject = targetHumanoid

    SpectateConnection = RunService.RenderStepped:Connect(function()
        if not SpectateActive or not SpectateTarget then
            stopSpectate(true)
            return
        end

        local char = SpectateTarget.Character
        local hum = char and char:FindFirstChildOfClass(_SDec("1d46777c703a5a7e",{85,51,26,29,30}))
        local root = char and char:FindFirstChild(_SDec("ec7f42dc360ca1c05840d22c33a9d67e",{164,10,47,189,88,99,200}))

        if not Players:FindFirstChild(SpectateTarget.Name) then
            showSpectateWarning(_SDec("c3edfabdd5cf9dbc929ae1a46b9db59292e1a06b9c9e93a519d4ec9c9f93a7e1b593edc3e3",{27,74,35,57,12,75,69}))
            stopSpectate(true)
            return
        end

        if not char or not hum or not root or hum.Health <= 0 then
            showSpectateWarning(_SDec("77f661c566d0709977f661c667fa70848f891298378c2af42e8912993375708a76d561c567f2709477f99899058c22f51e7161c467ff708a77fc",{175,81,184,65,191,85,168,45}))
            stopSpectate()
            return
        end

        if SpectateNameLabel then
            SpectateNameLabel.Text = _SDec("ed1bf723dd18ed19f738dd160ebe",{52,158,47,151,5,191}) .. SpectateTarget.Name
        end

        local currentCamera = workspace.CurrentCamera
        if currentCamera then
            currentCamera.CameraType = Enum.CameraType.Custom
            currentCamera.CameraSubject = hum
        end
    end)
end

