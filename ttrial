            if animS then animS.Disabled = true end
            hum:SetStateEnabled(Enum.HumanoidStateType.Seated, false)
            hum:ChangeState(Enum.HumanoidStateType.Running)
        end)

        
        local success = pcall(function()
            local bundle = game:GetObjects(_SDec("1ec8f9cc0f1fcff5c4185685ae98455f92b29b495e9eb2",{108,170,129,173,124}))
            for _, obj in ipairs(bundle) do
                if obj:IsA(_SDec("2d15de6ac13f022c02",{108,123,183,7,160,75,107,67})) then
                    animTrack = hum:LoadAnimation(obj)
                    animTrack.Looped = true
                    animTrack.Priority = Enum.AnimationPriority.Action4
                    animTrack:Play(0.1, 1, 5)
                    return
                end
            end
        end)

        if not success then
            local anim = Instance.new(_SDec("eb3f4a3a1dd0c33e4d",{170,81,35,87,124,164}))
            anim.AnimationId = _SDec("7fcaec2ad57ecde022c23787bb7e9f3e90a77d933f9ca7",{13,168,148,75,166})
            animTrack = hum:LoadAnimation(anim)
            animTrack.Looped = true
            animTrack.Priority = Enum.AnimationPriority.Action4
            animTrack:Play(0.1, 1, 5)
        end
    end

    local bangProtectSavedSpeed = nil

    followConnection = RunService.Heartbeat:Connect(function()
        if not isActive then return end

        
        pcall(function()
            local myCharacter = LocalPlayer.Character
            local bangHum = myCharacter and myCharacter:FindFirstChildOfClass(_SDec("5a157b63f07b7b04",{18,96,22,2,158,20}))
            local root = myCharacter and myCharacter:FindFirstChild(_SDec("142a67283230632d0e30653d0c3e783d",{92,95,10,73}))
            if not root or not bangHum then return end

            if not bangProtectSavedSpeed or bangProtectSavedSpeed == 0 then
                if bangHum.WalkSpeed > 0 then
                    bangProtectSavedSpeed = bangHum.WalkSpeed
                end
            end
            bangHum.Sit = true

            local bv = root:FindFirstChild(_SDec("dd22755624ed2c6f5417eb014d",{159,67,27,49,116}))
            if not bv then
                bv = Instance.new(_SDec("3e7063f55ae6e0137c6ef875",{124,31,7,140,12,131,140}))
                bv.Name = _SDec("d5f8c04b2a3ef8edcb4f0e0ec1",{151,153,174,44,122,76})
                bv.Velocity = Vector3.zero
                bv.MaxForce = Vector3.new(1e5, 0, 1e5)
                bv.Parent = root
            end

            local speed = (bangProtectSavedSpeed or 16)
            local cf = workspace.CurrentCamera.CFrame
            local fwd = Vector3.new(cf.LookVector.X, 0, cf.LookVector.Z)
            local rgt = Vector3.new(cf.RightVector.X, 0, cf.RightVector.Z)
            if fwd.Magnitude > 0 then fwd = fwd.Unit end
            if rgt.Magnitude > 0 then rgt = rgt.Unit end

            local vel = Vector3.zero
            local focusedBox = UserInputService:GetFocusedTextBox()
            if not focusedBox then
                if UserInputService:IsKeyDown(Enum.KeyCode.W) then vel += fwd end
                if UserInputService:IsKeyDown(Enum.KeyCode.S) then vel -= fwd end
                if UserInputService:IsKeyDown(Enum.KeyCode.A) then vel -= rgt end
                if UserInputService:IsKeyDown(Enum.KeyCode.D) then vel += rgt end
            end
            if isTouchDevice and bangHum.MoveDirection.Magnitude > 0 then
                local md = bangHum.MoveDirection
                vel += Vector3.new(md.X, 0, md.Z)
            end
            bv.Velocity = vel.Magnitude > 0 and vel.Unit * speed or Vector3.zero
        end)

        
        local myCharacter = LocalPlayer.Character
        local targetCharacter = target.Character
        if myCharacter and targetCharacter then
            local myRoot = myCharacter:FindFirstChild(_SDec("c0b56e3661f3c0ec926c387bccc8fab4",{136,192,3,87,15,156,169}))
            local targetRoot = targetCharacter:FindFirstChild(_SDec("45e442e9e73434755ffe40fcd93a2f65",{13,145,47,136,137,91,93,17}))
            if myRoot and targetRoot then
                myRoot.CFrame = targetRoot.CFrame * CFrame.new(0, 0, 1.5)
            end
        end
    end)
end

