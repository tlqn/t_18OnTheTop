local function hangAutoCuff(cuff, bodyPart)
    local origCamType = workspace.CurrentCamera.CameraType
    local myRoot = LocalPlayer.Character and LocalPlayer.Character:FindFirstChild(_SDec("22377d434a5030de382d7f56745e2bce",{106,66,16,34,36,63,89,186}))
    pcall(function()
        workspace.CurrentCamera.CameraType = Enum.CameraType.Scriptable
        local dir = (bodyPart.Position - myRoot.Position).Unit
        workspace.CurrentCamera.CFrame = CFrame.lookAt(
            bodyPart.Position - dir * 3 + Vector3.new(0, 0.5, 0),
            bodyPart.Position
        )
    end)
    task.wait(0.04)
    local cam = workspace.CurrentCamera
    local vp  = cam.ViewportSize
    local sp, vis = cam:WorldToScreenPoint(bodyPart.Position)
    local tx = (vis and sp.Z > 0) and sp.X or (vp.X / 2)
    local ty = (vis and sp.Z > 0) and sp.Y or (vp.Y / 2)
    local mouse = LocalPlayer:GetMouse()
    local mt, orig, hooked = nil, nil, false
    pcall(function()
        mt   = getrawmetatable(mouse)
        orig = mt.__index
        setreadonly(mt, false)
        mt.__index = function(self, key)
            if key == _SDec("3c04fef1eaea",{104,101,140,150,143,158,140,67}) then return bodyPart end
            if key == _SDec("46e9f5",{14,128,129,82,6})    then return CFrame.new(bodyPart.Position) end
            if type(orig) == _SDec("f0c873dce5ffd273",{150,189,29,191,145}) then return orig(self, key) end
            return orig[key]
        end
        setreadonly(mt, true)
        hooked = true
    end)
    pcall(function()
        if mousemoveabs then mousemoveabs(tx, ty) end
        if mouse1click then mouse1click()
        elseif mouse1press then mouse1press() task.wait(0.03) mouse1release() end
    end)
    task.wait(0.04)
    pcall(function()
        local vim = game:GetService(_SDec("e3aed8da2a3e275adbb7dfda123e2572d2a2d8",{181,199,170,174,95,95,75,19}))
        vim:SendMouseButtonEvent(tx, ty, 0, true,  game, 1)
        task.wait(0.03)
        vim:SendMouseButtonEvent(tx, ty, 0, false, game, 1)
    end)
    task.wait(0.05)
    pcall(function() workspace.CurrentCamera.CameraType = origCamType end)
    if hooked and mt and orig then
        pcall(function()
            setreadonly(mt, false)
            mt.__index = orig
            setreadonly(mt, true)
        end)
    end
end

