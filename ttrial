local function startBang(target)
    isActive = true
    setButtonState(BangBtn, true, T18T(_SDec("1ddd70dfd019a662a128",{197,120,169,85,9,155,126})), T18T(_SDec("8b6bcbd459a38c96",{83,195,19,115,128,37,85,20})), Theme.Danger, Theme.PanelSoft)

