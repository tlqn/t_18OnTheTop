function GetHeadChatBubbleSpeakerKey(fromUserId, fromName)
    local numericUserId = tonumber(fromUserId)
    if numericUserId and numericUserId > 0 then
        return _SDec("e407c1af",{145,110,165,149,44,138}) .. tostring(numericUserId)
    end
    return _SDec("02122ddb56",{108,115,64,190}) .. tostring(fromName or _SDec("33",{12,138,159,39,125,200,164,118})):lower()
end

function DestroyHeadChatBubbleStack(speakerKey)
    local state = HeadChatBubbleState[speakerKey]
    if not state then
        return
    end

    if state.guis then
        for _, gui in ipairs(state.guis) do
            pcall(function()
                gui:Destroy()
            end)
        end
    end

    state.guis = {}
end







