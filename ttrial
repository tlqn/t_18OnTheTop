    local char = LocalPlayer.Character
    local root = char and char:FindFirstChild(_SDec("dc14a822e60dfd05972ce716c400b737",{148,97,197,67,136,98}))
    local hum = char and char:FindFirstChild(_SDec("7b633c34f3d8d957",{51,22,81,85,157,183,176}))
    local targetChar = target and target.Character
    local targetRoot = targetChar and targetChar:FindFirstChild(_SDec("22dcd87565ab210efbda7b7f942918dd",{106,169,181,20,11,196,72}))

    if not root or not hum or not targetRoot then
        return
    end

    targetFlingActive = true
    targetFlingSavedCFrame = root.CFrame
    targetFlingAngle = 0
    targetFlingPulse = 0
    targetFlingStartTargetY = targetRoot.Position.Y
    targetFlingStartTime = tick()
    hum.AutoRotate = false

    targetFlingAngularVelocity = Instance.new(_SDec("3846c2dc1fc51d5ccac42cfd1f45c9c637df03",{122,41,166,165,94,171}))
    targetFlingAngularVelocity.Name = _SDec("cb34cee85beb13d0e650f814d2e84bf334ced95bf33adfe64ae6",{159,85,188,143,62})
    targetFlingAngularVelocity.MaxTorque = Vector3.new(0, math.huge, 0)
    targetFlingAngularVelocity.AngularVelocity = Vector3.new(0, 2400, 0)
    targetFlingAngularVelocity.P = 100000
    targetFlingAngularVelocity.Parent = root

    setButtonState(TargetFlingBtn, true, T18T(_SDec("e53d9d15f0c0b49a41c5bff1e5b5b941c546ad9beae41a",{61,152,68,159,41,66,108})), T18T(_SDec("f397fcc9c5cb9cf6",{42,22,37,77,28,77,69,116})), Theme.Danger, Theme.PanelSoft)

    targetFlingConnection = RunService.Heartbeat:Connect(function()
        if not targetFlingActive then
            return
        end

        local myChar = LocalPlayer.Character
        local myRoot = myChar and myChar:FindFirstChild(_SDec("f92b4f7cf0de37464ff1de2a727cecc5",{177,94,34,29,158}))
        local myHum = myChar and myChar:FindFirstChild(_SDec("25decf5bd206c209",{109,171,162,58,188,105,171}))
        local currentTargetChar = target.Character
        local currentTargetRoot = currentTargetChar and currentTargetChar:FindFirstChild(_SDec("771fac4525d359106d05ae501bdd4200",{63,106,193,36,75,188,48,116}))
        local currentTargetHum = currentTargetChar and currentTargetChar:FindFirstChildOfClass(_SDec("d13ff348f344f02e",{153,74,158,41,157,43}))

        if not myRoot or not myHum or myHum.Health <= 0 or not currentTargetRoot or not currentTargetHum or currentTargetHum.Health <= 0 then
            stopTargetFling(true)
            return
        end

        local targetRaisedEnough = targetFlingStartTargetY and currentTargetRoot.Position.Y > (targetFlingStartTargetY + 5)
        local targetGoingUpFast = currentTargetRoot.AssemblyLinearVelocity.Y > 55
        local activeLongEnough = (tick() - targetFlingStartTime) > 0.18

        if activeLongEnough and (targetRaisedEnough or targetGoingUpFast) then
            stopTargetFling(true)
            return
        end

        targetFlingAngle += math.rad(160)
        targetFlingPulse = (targetFlingPulse % 3) + 1

        local contactOffsets = {
            CFrame.new(0, -2.35, 0),
            CFrame.Angles(0, targetFlingAngle, 0) * CFrame.new(0.55, -1.15, 0.2),
            CFrame.Angles(0, -targetFlingAngle, 0) * CFrame.new(-0.55, -1.15, 0.2),
        }

        myRoot.CFrame = currentTargetRoot.CFrame * contactOffsets[targetFlingPulse]

        local lateralPush = currentTargetRoot.CFrame.RightVector * 110
        if targetFlingPulse == 3 then
            lateralPush = -lateralPush
        end

        myRoot.AssemblyLinearVelocity = lateralPush + Vector3.new(0, 95, 0)
    end)
end

